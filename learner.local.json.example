{
  "level": "intermediaire",
  "enabled": true,
  "recapEvery": 3,
  "questionStyles": "auto",
  "language": "fr",
  "trouBlanks": 2,
  "trackGlobs": [
    "*.kt", "*.java", "*.scala",
    "*.py", "*.rb", "*.go", "*.rs", "*.php", "*.cs", "*.swift",
    "*.ts", "*.tsx", "*.js", "*.jsx", "*.vue",
    "*.sql", "*.graphql", "*.proto",
    "*.properties", "*.yaml", "*.yml"
  ]
}